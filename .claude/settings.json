{
  "permissions": {
    "allow": [
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(scripts/ai-review-context.sh *)",
      "Bash(./scripts/ai-review-context.sh *)",
      "Bash(npm test *)",
      "Bash(npm run test:coverage *)",
      "Bash(npm run lint *)",
      "Bash(npm run typecheck *)",
      "Bash(npx vitest run *)",
      "Bash(npm audit)",
      "Bash(npm audit --json*)",
      "Bash(npm audit --omit*)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(**/.env*)"
    ],
    "ask": [
      "Bash(npm audit fix*)",
      "Bash(git diff --output*)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(git stash *)",
      "Bash(gh pr merge *)",
      "Bash(rm *)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(sed -i *)",
      "Bash(perl -pi *)",
      "Bash(perl -0pi *)"
    ]
  }
}
